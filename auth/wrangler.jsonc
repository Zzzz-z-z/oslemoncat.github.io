    "CMS_ORIGIN": "https://oslemoncat.github.io",
    "REPOSITORY": "oslemoncat/oslemoncat.github.io",
    "ALLOWED_GITHUB_LOGIN": "oslemoncat",
    "CALLBACK_URL": "https://lemoncat-cms-auth.zhounanxuan071106.workers.dev/callback"
  }
}
